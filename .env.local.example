# Neon PostgreSQL (obter em https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Credenciais de login (usuário único)
AUTH_USER=admin
AUTH_PASS=coloque-uma-senha-forte-aqui

# Chave secreta para assinar tokens HMAC (gerar com: openssl rand -hex 32)
AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Origem da aplicação (usada no allowedOrigins das Server Actions)
APP_ORIGIN=http://localhost:3000

# Desabilitar cookie Secure em desenvolvimento HTTP (false = permite HTTP)
SESSION_COOKIE_SECURE=false
